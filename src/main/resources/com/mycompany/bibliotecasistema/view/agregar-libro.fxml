<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Alta de un libro con sus primeros ejemplares. -->
<StackPane styleClass="modal-contenedor" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bibliotecasistema.controller.ModalController">
    <VBox styleClass="modal, modal-simple" prefWidth="560" maxWidth="560">

        <Label text="Agregar libro" styleClass="modal-titulo-simple"/>

        <VBox spacing="6">
            <Label text="Título" styleClass="form-etiqueta"/>
            <TextField fx:id="txtTitulo" styleClass="campo-modal"/>
        </VBox>

        <VBox spacing="6">
            <HBox spacing="4">
                <Label text="Autores" styleClass="form-etiqueta"/>
                <Label text="(sepáralos con comas)" styleClass="etiqueta-opcional"/>
            </HBox>
            <TextField fx:id="txtAutores" styleClass="campo-modal"/>
        </VBox>

        <GridPane hgap="16" vgap="6">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <Label text="ISBN" styleClass="form-etiqueta" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtIsbn" styleClass="campo-modal" promptText="978-..."
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label text="Editorial" styleClass="form-etiqueta" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <TextField fx:id="txtEditorial" styleClass="campo-modal" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Año de publicación" styleClass="form-etiqueta" GridPane.rowIndex="2"
                   GridPane.columnIndex="0" style="-fx-padding: 8 0 0 0;"/>
            <TextField fx:id="txtAnio" styleClass="campo-modal" promptText="2024"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label text="Ejemplares a registrar" styleClass="form-etiqueta" GridPane.rowIndex="2"
                   GridPane.columnIndex="1" style="-fx-padding: 8 0 0 0;"/>
            <TextField fx:id="txtCantidad" styleClass="campo-modal" text="1"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <VBox spacing="6">
            <Label text="Ubicación de los ejemplares" styleClass="form-etiqueta"/>
            <HBox spacing="10">
                <ComboBox fx:id="cbPasillo" styleClass="combo-modal" maxWidth="Infinity" HBox.hgrow="ALWAYS"><items><FXCollections fx:factory="observableArrayList"><String fx:value="Pasillo A"/><String fx:value="Pasillo B"/><String fx:value="Pasillo C"/><String fx:value="Pasillo D"/><String fx:value="Pasillo E"/></FXCollections></items><value><String fx:value="Pasillo A"/></value></ComboBox>
                <ComboBox fx:id="cbEstante" styleClass="combo-modal" maxWidth="Infinity" HBox.hgrow="ALWAYS"><items><FXCollections fx:factory="observableArrayList"><String fx:value="Estante 1"/><String fx:value="Estante 2"/><String fx:value="Estante 3"/><String fx:value="Estante 4"/><String fx:value="Estante 5"/><String fx:value="Estante 6"/></FXCollections></items><value><String fx:value="Estante 1"/></value></ComboBox>
                <ComboBox fx:id="cbFila" styleClass="combo-modal" maxWidth="Infinity" HBox.hgrow="ALWAYS"><items><FXCollections fx:factory="observableArrayList"><String fx:value="Fila 1"/><String fx:value="Fila 2"/><String fx:value="Fila 3"/><String fx:value="Fila 4"/><String fx:value="Fila 5"/></FXCollections></items><value><String fx:value="Fila 1"/></value></ComboBox>
            </HBox>
            <Label fx:id="lblCodigos" text="Los códigos de barras se asignan solos al guardar." styleClass="mensaje-ayuda" wrapText="true"/>
        </VBox>

        <Label fx:id="lblError" styleClass="mensaje-error" wrapText="true" minHeight="-Infinity"/>

        <HBox styleClass="modal-pie-simple">
            <Button text="Cancelar" onAction="#cerrar" styleClass="boton-secundario"/>
            <Button text="Guardar libro" onAction="#cerrar" styleClass="boton-primario" defaultButton="true"/>
        </HBox>
    </VBox>
</StackPane>
