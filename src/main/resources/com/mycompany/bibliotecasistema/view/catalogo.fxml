<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Catálogo de libros: mismo FXML para Estudiante y Administrador (el rol se lee de Sesion). -->
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.bibliotecasistema.controller.CatalogoController">
    <top>
        <fx:include fx:id="navbar" source="navbar.fxml"/>
    </top>

    <center>
        <VBox styleClass="contenido">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Catálogo de libros" styleClass="titulo-seccion"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAgregarLibro" text="+ Agregar libro" styleClass="boton-primario"
                        onAction="#agregarLibro"/>
            </HBox>

            <TextField fx:id="txtBusqueda" styleClass="campo-busqueda"
                       promptText="Busca libro por título, autor o ISBN"/>

            <StackPane VBox.vgrow="ALWAYS">
                <ScrollPane fx:id="scrollLibros" styleClass="scroll-catalogo" fitToWidth="true"
                            hbarPolicy="NEVER">
                    <FlowPane fx:id="panelLibros" styleClass="panel-libros"/>
                </ScrollPane>
                <Label fx:id="lblSinResultados" text="No se encontraron libros"
                       styleClass="sin-resultados" StackPane.alignment="TOP_CENTER"/>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
