<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Modal de préstamo en dos pasos: 1) identificar al alumno, 2) datos del préstamo. -->
<StackPane styleClass="modal-contenedor" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bibliotecasistema.controller.PrestamoController">
    <VBox styleClass="modal" prefWidth="540" maxWidth="540">

        <HBox styleClass="modal-encabezado">
            <Region styleClass="modal-lomo"/>
            <VBox alignment="CENTER_LEFT">
                <Label text="Préstamo" styleClass="modal-titulo"/>
            </VBox>
        </HBox>

        <StackPane fx:id="pasos">

            <!-- PASO 1: identificar al alumno -->
            <VBox fx:id="paso1">
                <VBox styleClass="modal-cuerpo" spacing="8">
                    <Label text="Paso 1 de 2 · Identificar al alumno" styleClass="modal-paso"/>
                    <Label text="Nombre del alumno" styleClass="form-etiqueta"/>
                    <TextField fx:id="txtNombre" styleClass="campo-modal" promptText="Nombre completo"/>
                    <Label text="Matrícula" styleClass="form-etiqueta"/>
                    <TextField fx:id="txtMatricula" styleClass="campo-modal" promptText="9 dígitos"/>
                    <Label fx:id="lblErrorMatricula" text="La matrícula debe tener 9 dígitos numéricos."
                           styleClass="mensaje-error"/>
                    <Label text="Estado del alumno" styleClass="form-etiqueta"/>
                    <Label fx:id="lblEstadoAlumno" styleClass="estado-alumno" maxWidth="Infinity"/>
                    <Label fx:id="lblAyudaNuevo"
                           text="El alumno no está registrado: se dará de alta al confirmar el préstamo."
                           styleClass="mensaje-ayuda" wrapText="true"/>
                </VBox>
                <HBox styleClass="modal-pie">
                    <Button fx:id="btnSiguiente" text="Siguiente" styleClass="boton-primario"
                            onAction="#siguiente"/>
                    <Button text="Cerrar" styleClass="boton-secundario" onAction="#cerrar"/>
                </HBox>
            </VBox>

            <!-- PASO 2: datos del préstamo -->
            <VBox fx:id="paso2">
                <VBox styleClass="modal-cuerpo" spacing="8">
                    <Label text="Paso 2 de 2 · Datos del préstamo" styleClass="modal-paso"/>
                    <Label text="Nombre del alumno" styleClass="form-etiqueta"/>
                    <TextField fx:id="txtNombreBloqueado" styleClass="campo-modal, campo-bloqueado"
                               editable="false" focusTraversable="false"/>
                    <Label text="Matrícula" styleClass="form-etiqueta"/>
                    <TextField fx:id="txtMatriculaBloqueada" styleClass="campo-modal, campo-bloqueado"
                               editable="false" focusTraversable="false"/>
                    <Label text="Ejemplar" styleClass="form-etiqueta"/>
                    <TextField fx:id="txtEjemplar" styleClass="campo-modal, campo-bloqueado"
                               editable="false" focusTraversable="false"/>
                    <HBox spacing="16">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Fecha de préstamo" styleClass="form-etiqueta"/>
                            <DatePicker fx:id="dpPrestamo" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Fecha de entrega" styleClass="form-etiqueta"/>
                            <DatePicker fx:id="dpEntrega" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="lblErrorFechas"
                           text="La fecha de entrega debe ser posterior a la fecha de préstamo."
                           styleClass="mensaje-error" wrapText="true"/>
                </VBox>
                <HBox styleClass="modal-pie">
                    <Button fx:id="btnRegistrar" text="Registrar préstamo" styleClass="boton-primario"
                            onAction="#registrar"/>
                    <Button text="Cerrar" styleClass="boton-secundario" onAction="#cerrar"/>
                </HBox>
            </VBox>
        </StackPane>
    </VBox>
</StackPane>
