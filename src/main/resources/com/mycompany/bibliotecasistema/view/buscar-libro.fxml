<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana secundaria del préstamo: busca el libro y elige el ejemplar exacto. -->
<StackPane styleClass="ventana-contenedor" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bibliotecasistema.controller.PrestamosController">
    <VBox styleClass="ventana, ventana-simple" prefWidth="760" maxWidth="760">

        <VBox spacing="3">
            <Label text="Buscar libro" styleClass="ventana-titulo-simple"/>
            <Label text="Busca por título, autor o ISBN, elige el libro y después el ejemplar que se llevará."
                   styleClass="ventana-subtitulo" wrapText="true"/>
        </VBox>

        <TextField fx:id="txtBuscarLibro" styleClass="campo-ventana" promptText="Título, autor o ISBN"/>

        <TableView fx:id="tablaLibros" styleClass="tabla" prefHeight="260" minHeight="260">
            <columns>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="240" sortable="false" reorderable="false"/>
                <TableColumn fx:id="colAutor" text="Autor" prefWidth="180" sortable="false" reorderable="false"/>
                <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="120" sortable="false" reorderable="false"/>
                <TableColumn fx:id="colDisponibles" text="Ejemplares disponibles" prefWidth="170" sortable="false" reorderable="false"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder>
                <Label fx:id="lblSinLibros" text="No se encontraron libros." styleClass="tabla-vacia"/>
            </placeholder>
        </TableView>

        <VBox spacing="6">
            <Label text="Ejemplar" styleClass="form-etiqueta"/>
            <ComboBox fx:id="cbCopia" styleClass="combo-ventana" maxWidth="Infinity"
                      promptText="Primero elige un libro de la tabla"/>
        </VBox>

        <Label fx:id="lblError" styleClass="mensaje-error" wrapText="true" minHeight="-Infinity"
               visible="false" managed="false"/>

        <HBox styleClass="ventana-pie-simple">
            <Button text="Cancelar" onAction="#cerrar" styleClass="boton-secundario"/>
            <Button text="Seleccionar" onAction="#seleccionarLibro" styleClass="boton-primario" defaultButton="true"/>
        </HBox>
    </VBox>
</StackPane>
