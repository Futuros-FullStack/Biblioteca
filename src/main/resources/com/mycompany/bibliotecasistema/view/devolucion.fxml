<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Modal para cerrar un préstamo: fecha real, estado del ejemplar y observaciones. -->
<StackPane styleClass="modal-contenedor" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bibliotecasistema.controller.ModalController">
    <VBox styleClass="modal, modal-simple" prefWidth="540" maxWidth="540">

        <VBox spacing="3">
            <Label text="Registrar devolución" styleClass="modal-titulo-simple"/>
            <Label fx:id="lblSubtitulo" text="[Título del libro] · [Código] · [Alumno]" styleClass="modal-subtitulo" wrapText="true"/>
        </VBox>

        <HBox styleClass="caja-info">
            <Label text="Fecha de entrega pactada:"/>
            <Label fx:id="lblFechaPactada" text="[Fecha]" styleClass="caja-info-dato"/>
        </HBox>

        <GridPane hgap="16" vgap="6">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <Label text="Fecha de devolución real" styleClass="form-etiqueta"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dpDevolucion" maxWidth="Infinity"
                        GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblPuntualidad" text="✓ A tiempo" styleClass="indicador, indicador-a-tiempo" wrapText="true"
                   GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="TOP"/>

            <Label text="Estado del ejemplar" styleClass="form-etiqueta"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <ComboBox fx:id="cbEstado" styleClass="combo-modal" maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1">
                <items><FXCollections fx:factory="observableArrayList"><String fx:value="Buen estado"/><String fx:value="Dañado"/><String fx:value="Extraviado"/></FXCollections></items><value><String fx:value="Buen estado"/></value>
            </ComboBox>
            <Label fx:id="lblAyudaEstado" text="Con “Buen estado” vuelve a quedar disponible." styleClass="mensaje-ayuda" wrapText="true" minHeight="-Infinity"
                   GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.valignment="TOP"/>
        </GridPane>

        <VBox spacing="6">
            <HBox spacing="4">
                <Label text="Observaciones" styleClass="form-etiqueta"/>
                <Label text="(opcional)" styleClass="etiqueta-opcional"/>
            </HBox>
            <TextArea fx:id="txtObservaciones" styleClass="area-modal" prefRowCount="2" wrapText="true"
                      promptText="Por ejemplo: trae la portada rayada"/>
        </VBox>

        <HBox styleClass="modal-pie-simple">
            <Button text="Cerrar" onAction="#cerrar" styleClass="boton-secundario"/>
            <Button fx:id="btnRegistrar" onAction="#cerrar" text="Registrar devolución" styleClass="boton-primario"/>
        </HBox>
    </VBox>
</StackPane>
