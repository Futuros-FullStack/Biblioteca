<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="login-fondo" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bibliotecasistema.controller.LoginController">
    <VBox fx:id="tarjeta" styleClass="login-tarjeta" alignment="TOP_CENTER"
          minWidth="450" prefWidth="450" maxWidth="450" minHeight="330" maxHeight="-Infinity">

        <Label text="UNIVERSIDAD AUTÓNOMA DE CHIAPAS" styleClass="login-institucion"/>
        <Label text="BIBLIOTECA" styleClass="login-titulo"/>
        <Label text="FACULTAD DE NEGOCIOS" styleClass="login-subtitulo"/>
        <Region styleClass="login-filete">
            <VBox.margin><Insets top="8" bottom="14"/></VBox.margin>
        </Region>

        <Label fx:id="lblEligeRol" text="Elige tu rol:" styleClass="login-etiqueta"
               maxWidth="Infinity"/>
        <ComboBox fx:id="cbRol" promptText="Selecciona un rol" styleClass="combo-login"
                  maxWidth="Infinity">
            <items><FXCollections fx:factory="observableArrayList"><String fx:value="Estudiante"/><String fx:value="Administrador"/></FXCollections></items>
        </ComboBox>

        <!-- Solo para Administrador -->
        <VBox fx:id="boxCredenciales" spacing="8">
            <Label text="Nombre de usuario o correo" styleClass="login-etiqueta">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Label>
            <TextField fx:id="txtUsuario" styleClass="input-login"
                       promptText="usuario@unach.mx"/>
            <Label text="Contraseña" styleClass="login-etiqueta">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Label>
            <PasswordField fx:id="txtContrasena" styleClass="input-login"
                           promptText="••••••••"/>
        </VBox>

        <Label fx:id="lblError" text="Usuario o contraseña incorrectos." styleClass="mensaje-error-login"
               wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

        <Button fx:id="btnIngresar" onAction="#ingresar" text="Ingresar" styleClass="boton-login" defaultButton="true"
                maxWidth="Infinity">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Button>
    </VBox>
</StackPane>
