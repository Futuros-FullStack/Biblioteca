<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Préstamos (solo administrador): próximas entregas y alumnos. -->
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bibliotecasistema.controller.PrestamosController">
    <top>
        <fx:include fx:id="navbar" source="navbar.fxml"/>
    </top>

    <center>
        <VBox styleClass="contenido">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Préstamos" styleClass="titulo-seccion"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Nuevo préstamo" onAction="#nuevoPrestamo" styleClass="boton-primario"/>
            </HBox>

            <HBox spacing="8">
                <ToggleButton fx:id="tabEntregas" text="Próximas entregas" styleClass="pestana" selected="true"/>
                <ToggleButton fx:id="tabAlumnos" text="Alumnos" styleClass="pestana"/>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <VBox.margin><Insets bottom="28"/></VBox.margin>

                <!-- Pestaña 1: préstamos sin devolver -->
                <VBox fx:id="panelEntregas" spacing="16">
                    <TextField fx:id="txtBuscarEntregas" styleClass="campo-busqueda"
                               promptText="Busca por matrícula o nombre" maxWidth="380"/>
                    <TableView fx:id="tablaEntregas" styleClass="tabla" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colAlumno" text="Alumno" prefWidth="140" minWidth="130" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colLibro" text="Libro" prefWidth="180" minWidth="150" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colEntrega" text="Entrega" prefWidth="100" minWidth="95" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="125" minWidth="115" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAviso" text="Aviso" prefWidth="130" minWidth="125" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAvisoAccion" prefWidth="95" minWidth="90" sortable="false" reorderable="false" styleClass="col-accion"/>
                            <TableColumn fx:id="colAccionEntrega" prefWidth="330" minWidth="320" sortable="false" reorderable="false" styleClass="col-accion"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder>
                            <Label fx:id="lblSinEntregas" text="No hay préstamos pendientes."
                                   styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Pestaña 2: alumnos -->
                <VBox fx:id="panelAlumnos" spacing="10" visible="false">
                    <Label text="1. Busca al alumno" styleClass="paso-etiqueta"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="txtBuscarAlumno" styleClass="campo-busqueda"
                                   promptText="Nombre o matrícula" prefWidth="380" maxWidth="380"/>
                        <Button text="+ Registrar alumno nuevo" onAction="#registrarAlumno" styleClass="boton-secundario"/>
                    </HBox>
                    <Label text="2. Selecciónalo en la lista para asignarle un préstamo. Si no aparece, regístralo primero."
                           styleClass="mensaje-ayuda" wrapText="true">
                        <VBox.margin><Insets bottom="6"/></VBox.margin>
                    </Label>
                    <TableView fx:id="tablaAlumnos" styleClass="tabla" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMatricula" text="Matrícula" prefWidth="110" minWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200" minWidth="180" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colActivos" text="Préstamos activos" prefWidth="140" minWidth="135" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colTotal" text="Total" prefWidth="70" minWidth="65" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colSituacion" text="Situación" prefWidth="130" minWidth="120" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAccionAlumno" prefWidth="230" minWidth="225" sortable="false" reorderable="false" styleClass="col-accion"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder>
                            <Label fx:id="lblSinAlumnos" text="No hay alumnos registrados."
                                   styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
