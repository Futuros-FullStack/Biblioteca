<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Registrar la reposición de un libro perdido: crea el ejemplar nuevo y desbloquea al alumno. -->
<StackPane styleClass="ventana-contenedor" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bibliotecasistema.controller.ReposicionController">
    <VBox styleClass="ventana, ventana-simple" prefWidth="500" maxWidth="500">

        <VBox spacing="3">
            <Label text="Registrar reposición" styleClass="ventana-titulo-simple"/>
            <Label fx:id="lblSubtitulo" styleClass="ventana-subtitulo" wrapText="true"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Código de barras del ejemplar nuevo" styleClass="form-etiqueta"/>
            <TextField fx:id="txtCodigo" styleClass="campo-ventana" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Fecha de adquisición" styleClass="form-etiqueta"/>
            <DatePicker fx:id="dpAdquisicion" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="lblError" styleClass="mensaje-error" wrapText="true" minHeight="-Infinity"
               visible="false" managed="false"/>

        <HBox styleClass="ventana-pie-simple">
            <Button text="Cerrar" onAction="#cerrar" styleClass="boton-secundario"/>
            <Button fx:id="btnGuardar" onAction="#guardar" text="Registrar reposición" styleClass="boton-primario" defaultButton="true"/>
        </HBox>
    </VBox>
</StackPane>
