<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Inventario (solo administrador): un renglón por ejemplar físico. -->
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bibliotecasistema.controller.InventarioController">
    <top>
        <fx:include fx:id="navbar" source="navbar.fxml"/>
    </top>

    <center>
        <VBox styleClass="contenido">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Inventario" styleClass="titulo-seccion"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Agregar libro" onAction="#agregarLibro" styleClass="boton-primario"/>
            </HBox>

            <TextField fx:id="txtBusqueda" styleClass="campo-busqueda"
                       promptText="Busca libro por título o código de barras" maxWidth="380"/>

            <TableView fx:id="tablaInventario" styleClass="tabla" VBox.vgrow="ALWAYS">
                <VBox.margin><Insets bottom="28"/></VBox.margin>
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90" minWidth="90" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colLibro" text="Libro" prefWidth="220" minWidth="220" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colUbicacion" text="Ubicación" prefWidth="220" minWidth="220" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colAdquirido" text="Adquirido" prefWidth="105" minWidth="105" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="115" minWidth="115" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colAcciones" prefWidth="210" minWidth="210" sortable="false" reorderable="false" styleClass="col-accion"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder>
                    <Label fx:id="lblSinResultados" text="Aún no hay ejemplares registrados."
                           styleClass="tabla-vacia"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>
</BorderPane>
