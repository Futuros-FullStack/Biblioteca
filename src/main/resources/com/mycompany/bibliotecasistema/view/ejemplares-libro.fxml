<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ejemplares de un libro, que se abre desde el inventario. -->
<StackPane styleClass="ventana-contenedor" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bibliotecasistema.controller.EjemplaresLibroController">
    <VBox styleClass="ventana, ventana-simple" prefWidth="720" maxWidth="720">

        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Ejemplares" styleClass="ventana-titulo-simple"/>
                <Label fx:id="lblTitulo" styleClass="ventana-subtitulo" wrapText="true"/>
            </VBox>
        </HBox>

        <TableView fx:id="tablaEjemplares" styleClass="tabla" prefHeight="320" minHeight="320">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="95" sortable="false" reorderable="false"/>
                <TableColumn fx:id="colUbicacion" text="Ubicación" prefWidth="230" sortable="false" reorderable="false"/>
                <TableColumn fx:id="colAdquirido" text="Adquirido" prefWidth="100" sortable="false" reorderable="false"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="115" sortable="false" reorderable="false"/>
                <TableColumn fx:id="colAcciones" prefWidth="90" sortable="false" reorderable="false" styleClass="col-accion"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder>
                <Label fx:id="lblSinEjemplares" text="Este libro aún no tiene ejemplares." styleClass="tabla-vacia"/>
            </placeholder>
        </TableView>

        <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" minHeight="-Infinity"
               visible="false" managed="false"/>

        <HBox styleClass="ventana-pie-simple">
            <Button text="Cerrar" onAction="#cerrar" styleClass="boton-secundario" defaultButton="true"/>
        </HBox>
    </VBox>
</StackPane>
